---
const currentYear = new Date().getFullYear();
---

<footer class="hidden md:block bg-gray-900 border-t border-gray-700 px-4 py-3">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-center space-y-2 md:space-y-0 md:space-x-4">
      <div class="text-gray-400 text-sm">
        © {currentYear} Ronnakrit Wananukan. All rights reserved.
      </div>
      <div class="flex space-x-4">
        <a 
          href="https://github.com/ronnakritnet" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-green-400 transition-colors duration-200"
        >
          GitHub
        </a>
        <a 
          href="https://linkedin.com/in/ronnakritnet" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-green-400 transition-colors duration-200"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</footer>
