---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalPath?: string;
  promptPath: string; // e.g. "ronnakrit@portfolio: ~/about"
  filename: string;   // e.g. "about_me.txt"
}

const {
  title,
  description,
  keywords,
  canonicalPath,
  promptPath,
  filename
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
>
  <Navbar />

  <main class="flex-1 flex items-center justify-center px-4 pt-20">
    <div class="w-full max-w-2xl">
      <!-- CLI-style container -->
      <div class="border border-green-600 bg-gray-900/50 p-8 rounded-lg shadow-lg mb-6">
        <!-- Terminal header -->
        <div class="border-b border-green-600 pb-4 mb-6">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-red-500">●</span>
            <span class="text-yellow-500">●</span>
            <span class="text-green-500">●</span>
            <span class="ml-4 text-gray-400 text-sm">{promptPath}</span>
          </div>
          <h1 class="text-2xl font-bold text-green-400 tracking-wider">{filename}</h1>
        </div>

        <!-- Dynamic page content -->
        <slot />

        <!-- Terminal prompt -->
        <div class="mt-8 pt-4 border-t border-green-600/30">
          <div class="flex items-center gap-2">
            <span class="text-green-500 font-bold">$</span>
            <span class="text-gray-500 animate-pulse">_</span>
          </div>
        </div>

        <!-- Back to terminal link -->
        <div class="mt-2 text-center">
          <a
            href="/"
            class="hover:text-green-300 hover:underline transition-colors duration-200 text-sm"
            style="color: var(--terminal-light-green);"
          >
            [ Return to Terminal ]
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
