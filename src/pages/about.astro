---
import TerminalPageLayout from '../layouts/TerminalPageLayout.astro';
---

<TerminalPageLayout
  title="About | RonnakritNet"
  description="About Ronnakrit Wananukan - Computer Engineering student passionate about Network Engineering, Automation, and Linux."
  keywords="Ronnakrit, About, Computer Engineering, Network Engineer, Portfolio, CLI, Terminal"
  canonicalPath="/about"
  promptPath="ronnakrit@portfolio: ~/about"
  filename="about_me.txt"
>
  <div class="space-y-6">
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        <p class="text-gray-400 mb-2"># Profile Information</p>
        <div class="space-y-2" style="color: var(--terminal-light-green);">
          <p><span class="text-green-400">Name:</span> Ronnakrit Wananukan</p>
          <p><span class="text-green-400">Education:</span> Computer Engineering Student at RMUTP</p>
          <p><span class="text-green-400">Background:</span> High Vocational Diploma in Information Technology</p>
          <p><span class="text-green-400">Focus:</span> Bridging systems infrastructure and software through Network Automation</p>
        </div>
      </div>
    </div>
    
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        <p class="text-gray-400 mb-2"># Technical Interests & Toolkit</p>
        <div class="space-y-2" style="color: var(--terminal-light-green);">
          <p>• Interested in Network Automation (Python, Netmiko, Ansible)</p>
          <p>• Linux Systems (Currently Learning)</p>
          <p>• Web Development (React, Astro & SEO Optimization)</p>
          <p>• CCNA Certification Preparation</p>
        </div>
      </div>
    </div>
    
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        <p class="text-gray-400 mb-2"># Current Focus</p>
        <p style="color: var(--terminal-light-green);">
          Actively preparing for CCNA certification while building practical
          experience in network engineering and automation projects.
        </p>
      </div>
    </div>
    
    <div class="border-t border-green-600/30 pt-6 mt-6">
      <div class="flex items-start gap-3">
        <span class="text-green-500 font-bold">$</span>
        <div class="flex-1">
          <p class="text-gray-400 mb-2"># Philosophy</p>
          <p style="color: var(--terminal-light-green);">
            "Simplicity is the ultimate sophistication."
          </p>
        </div>
      </div>
    </div>
  </div>
</TerminalPageLayout>
