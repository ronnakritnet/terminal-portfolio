---
import TerminalPageLayout from '../layouts/TerminalPageLayout.astro';
import { CERTS_DATA } from '../data/portfolio';
---

<TerminalPageLayout
  title="Certifications | RonnakritNet"
  description="Professional certifications of Ronnakrit Wananukan - Google IT Support Professional and Google Cybersecurity Professional credentials."
  keywords="Ronnakrit, Certifications, Computer Engineering, Network Engineer, Portfolio, CLI, Terminal"
  canonicalPath="/certs"
  promptPath="ronnakrit@portfolio: ~/certs"
  filename="verified_credentials.json"
>
  <div class="space-y-6">
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        {CERTS_DATA.map((cert, idx) => (
          <div>
            {idx > 0 && <p class="text-gray-400 my-4">---------------------------------------------------------</p>}
            <p class="text-gray-400 mb-4">=========================================================</p>
            <p class="text-green-400 font-bold mb-2">CERTIFICATION: {cert.title}</p>
            <p class="text-gray-400 mb-4">=========================================================</p>
            <div class="space-y-1 mb-4" style="color: var(--terminal-light-green);">
              <p>Issuer       : {cert.issuer}</p>
              <p>Status       : {cert.status}</p>
              <p>Credential   : <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="hover:text-green-300 hover:underline transition-colors">{cert.credentialUrl}</a></p>
              <p>Core Focus   : {cert.coreFocus}</p>
            </div>
            
            <p class="text-gray-400 mb-2">KEY KNOWLEDGE AREAS:</p>
            <div class="space-y-1 mb-4" style="color: var(--terminal-light-green);">
              {cert.keyKnowledgeAreas.map(area => (
                <p>- {area}</p>
              ))}
            </div>
          </div>
        ))}
        <p class="text-gray-400 mt-4">---------------------------------------------------------</p>
      </div>
    </div>
    
    <div class="border-t border-green-600/30 pt-6 mt-6">
      <div class="flex items-start gap-3">
        <span class="text-green-500 font-bold">$</span>
        <div class="flex-1">
          <p class="text-gray-400 mb-2"># Status</p>
          <p style="color: var(--terminal-light-green);">
            <span class="animate-pulse">●</span> {CERTS_DATA.length} professional certifications verified
          </p>
        </div>
      </div>
    </div>
  </div>
</TerminalPageLayout>
