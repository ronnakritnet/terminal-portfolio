---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
---

<!DOCTYPE html>
<html lang="en">
	<head>
	<meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        
        <title>Contact | RonnakritNet</title>
        <meta name="description" content="Contact Ronnakrit Wananukan - Computer Engineering student passionate about Network Engineering, Automation, and Linux." />
        <meta name="keywords" content="Ronnakrit, Contact, Computer Engineering, Network Engineer, Portfolio, CLI, Terminal" />
        <meta name="author" content="Ronnakrit Wananukan" />
        
        <meta property="og:title" content="Contact | RonnakritNet" />
        <meta property="og:description" content="Get in touch with Ronnakrit Wananukan - Computer Engineering student passionate about Network Engineering, Automation, and Linux." />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://ronnakrit.net/contact" />
        <meta property="og:image" content="https://ronnakrit.net/og-preview.png" />
        <meta property="og:image:alt" content="Contact | RonnakritNet" />
        <meta property="og:site_name" content="RonnakritNet" />
        
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Contact | RonnakritNet" />
        <meta name="twitter:description" content="Get in touch with Ronnakrit Wananukan - Computer Engineering student passionate about Network Engineering, Automation, and Linux." />
        <meta name="twitter:image" content="https://ronnakrit.net/og-preview.png" />
        <meta name="twitter:image:alt" content="Contact | RonnakritNet" />
        
        <meta name="robots" content="index, follow" />
        <meta name="language" content="English" />
        <meta name="theme-color" content="#0D0D0D" />
	</head>
	<body class="bg-black text-green-400 font-mono min-h-screen flex flex-col">
		<Navbar client:load />
		
		<main class="flex-1 flex items-center justify-center px-4 py-16">
			<div class="w-full max-w-2xl">
				<!-- CLI-style container -->
				<div class="border border-green-600 bg-gray-900/50 p-8 rounded-lg shadow-lg">
					<!-- Terminal header -->
					<div class="border-b border-green-600 pb-4 mb-6">
						<div class="flex items-center gap-2 mb-2">
							<span class="text-red-500">●</span>
							<span class="text-yellow-500">●</span>
							<span class="text-green-500">●</span>
							<span class="ml-4 text-gray-400 text-sm">contact@ronnakrit.net</span>
						</div>
						<h1 class="text-2xl font-bold text-green-400 tracking-wider">CONTACT_INFO</h1>
					</div>
					
					<!-- Contact content -->
					<div class="space-y-6">
						<div class="flex items-start gap-3">
							<span class="text-green-500 font-bold">$</span>
							<div class="flex-1">
								<p class="text-gray-400 mb-2"># Email Communication</p>
								<a 
									href="mailto:contact@ronnakrit.net" 
									class="hover:text-green-300 hover:underline transition-colors duration-200"
									style="color: var(--terminal-light-green);"
								>
									contact@ronnakrit.net
								</a>
							</div>
						</div>
						
						<div class="flex items-start gap-3">
							<span class="text-green-500 font-bold">$</span>
							<div class="flex-1">
								<p class="text-gray-400 mb-2"># GitHub Profile</p>
								<a 
									href="https://github.com/ronnakritnet" 
									target="_blank" 
									rel="noopener noreferrer"
									class="hover:text-green-300 hover:underline transition-colors duration-200"
									style="color: var(--terminal-light-green);"
								>
									github.com/ronnakritnet
								</a>
							</div>
						</div>
						
						<div class="flex items-start gap-3">
							<span class="text-green-500 font-bold">$</span>
							<div class="flex-1">
								<p class="text-gray-400 mb-2"># LinkedIn Profile</p>
								<a 
									href="https://linkedin.com/in/ronnakritnet" 
									target="_blank" 
									rel="noopener noreferrer"
									class="hover:text-green-300 hover:underline transition-colors duration-200"
									style="color: var(--terminal-light-green);"
								>
									linkedin.com/in/ronnakritnet
								</a>
							</div>
						</div>
						
						<div class="border-t border-green-600/30 pt-6 mt-6">
							<div class="flex items-start gap-3">
								<span class="text-green-500 font-bold">$</span>
								<div class="flex-1">
									<p class="text-gray-400 mb-2"># Status</p>
									<p style="color: var(--terminal-light-green);">
										<span class="animate-pulse">●</span> Available for opportunities
									</p>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Terminal prompt -->
					<div class="mt-8 pt-4 border-t border-green-600/30">
						<div class="flex items-center gap-2">
							<span class="text-green-500 font-bold">$</span>
							<span class="text-gray-500 animate-pulse">_</span>
						</div>
					</div>
				</div>
				
				<!-- Back to terminal link -->
				<div class="mt-6 text-center">
					<a 
						href="/" 
						class="text-green-400 hover:text-green-300 hover:underline transition-colors duration-200 text-sm"
					>
						[ Return to Terminal ]
					</a>
				</div>
			</div>
		</main>
		
		<Footer client:load />
	</body>
</html>
