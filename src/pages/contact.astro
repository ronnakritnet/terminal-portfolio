---
import TerminalPageLayout from '../layouts/TerminalPageLayout.astro';
---

<TerminalPageLayout
  title="Contact | RonnakritNet"
  description="Contact Ronnakrit Wananukan - Computer Engineering student passionate about Network Engineering, Automation, and Linux."
  keywords="Ronnakrit, Contact, Computer Engineering, Network Engineer, Portfolio, CLI, Terminal"
  canonicalPath="/contact"
  promptPath="ronnakrit@portfolio: ~/contact"
  filename="CONTACT_INFO"
>
  <div class="space-y-6">
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        <p class="text-gray-400 mb-2"># Contact Purpose</p>
        <p style="color: var(--terminal-light-green);">
          <span class="animate-pulse">●</span> Reach out for collaborations or internship opportunities.
        </p>
      </div>
    </div>

    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        <p class="text-gray-400 mb-2"># Email Communication</p>
        <a 
          href="mailto:contact@ronnakrit.net" 
          class="hover:text-green-300 hover:underline transition-colors duration-200"
          style="color: var(--terminal-light-green);"
        >
          contact@ronnakrit.net
        </a>
      </div>
    </div>
    
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        <p class="text-gray-400 mb-2"># GitHub Profile</p>
        <a 
          href="https://github.com/ronnakritnet" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hover:text-green-300 hover:underline transition-colors duration-200"
          style="color: var(--terminal-light-green);"
        >
          github.com/ronnakritnet
        </a>
      </div>
    </div>
    
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        <p class="text-gray-400 mb-2"># LinkedIn Profile</p>
        <a 
          href="https://linkedin.com/in/ronnakritnet" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hover:text-green-300 hover:underline transition-colors duration-200"
          style="color: var(--terminal-light-green);"
        >
          linkedin.com/in/ronnakritnet
        </a>
      </div>
    </div>
    
    <div class="border-t border-green-600/30 pt-6 mt-6">
      <div class="flex items-start gap-3">
        <span class="text-green-500 font-bold">$</span>
        <div class="flex-1">
          <p class="text-gray-400 mb-2"># Status</p>
          <p style="color: var(--terminal-light-green);">
            <span class="animate-pulse">●</span> Looking for Internship (2026-2027)
          </p>
        </div>
      </div>
    </div>
  </div>
</TerminalPageLayout>
