---
import TerminalPageLayout from '../layouts/TerminalPageLayout.astro';
import { PROJECTS_DATA } from '../data/portfolio';
---

<TerminalPageLayout
  title="Projects | RonnakritNet"
  description="Portfolio projects of Ronnakrit Wananukan - Interactive terminal portfolio and Academic Schedule Manager system."
  keywords="Ronnakrit, Projects, Computer Engineering, Network Engineer, Portfolio, CLI, Terminal"
  canonicalPath="/projects"
  promptPath="ronnakrit@portfolio: ~/projects"
  filename="deployed_projects.log"
>
  <div class="space-y-6">
    <div class="flex items-start gap-3">
      <span class="text-green-500 font-bold">$</span>
      <div class="flex-1">
        {PROJECTS_DATA.map((proj, idx) => (
          <div>
            {idx > 0 && <p class="text-gray-400 my-4">---------------------------------------------------------</p>}
            <p class="text-gray-400 mb-4">=========================================================</p>
            <p class="text-green-400 font-bold mb-2">{proj.numberStr}: {proj.title}</p>
            <p class="text-gray-400 mb-4">=========================================================</p>
            <p class="mb-4" style="color: var(--terminal-light-green);">
              {proj.description}
            </p>
            
            <p class="text-gray-400 mb-2">FEATURES:</p>
            <div class="space-y-1 mb-4" style="color: var(--terminal-light-green);">
              {proj.features.map(feat => (
                <p>- {feat}</p>
              ))}
            </div>
            
            <p class="text-gray-400 mb-2">TECHNOLOGIES:</p>
            <div class="space-y-1" style="color: var(--terminal-light-green);">
              {proj.technologies.map(tech => (
                <p>- {tech.label.padEnd(16)}: {tech.value}</p>
              ))}
            </div>
          </div>
        ))}
        <p class="text-gray-400 mt-4">---------------------------------------------------------</p>
      </div>
    </div>
    
    <div class="border-t border-green-600/30 pt-6 mt-6">
      <div class="flex items-start gap-3">
        <span class="text-green-500 font-bold">$</span>
        <div class="flex-1">
          <p class="text-gray-400 mb-2"># Status</p>
          <p style="color: var(--terminal-light-green);">
            <span class="animate-pulse">●</span> 1 project deployed production, 1 in local sandbox
          </p>
        </div>
      </div>
    </div>
  </div>
</TerminalPageLayout>
